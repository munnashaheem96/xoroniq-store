# Razorpay Payment Gateway Credentials (Get these from your Razorpay Dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Automated Order Email Notification Settings
# Sender: orders@xoroniq.store -> Recipient: xoroniq@gmail.com
MAIL_FROM="XORONIQ Store" <orders@xoroniq.store>
MAIL_TO=xoroniq@gmail.com

# SMTP Server Configuration (e.g. Gmail SMTP, Hostinger, Zoho, SendGrid, Amazon SES)
# For Gmail SMTP: host=smtp.gmail.com, port=465, secure=true, user=your_email, pass=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@xoroniq.store
SMTP_PASS=your_smtp_app_password_here

# Server Port
PORT=8080
